<!-- wp:acf/careers-about {"id":"block_642da3147a699","name":"acf/careers-about","data":{"block_intro":"\u003ch2\u003eWORKING AT BONBIRD.\u003c/h2\u003e\r\nWe all share a passion for great food but don’t take life too seriously.","_block_intro":"field_642add6694ee6","image":194,"_image":"field_642addfe94ee9","about_copy":"\u003ch3\u003ePASSION FOR GREAT PEOPLE\u003c/h3\u003e\r\nAt Bonbird, our mission is to make chicken great again. Our values are at the heart of what we do and what we stand for. We support all of our team members, offering training and support to develop their skills and experiences.","_about_copy":"field_642add8e94ee7","cta_link":{"title":"Join the team","url":"/careers/","target":""},"_cta_link":"field_642addec94ee8"},"align":"","mode":"edit"} /-->
