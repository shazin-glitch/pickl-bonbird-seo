<?php
/**
 * taxonomy-city.php — the /<iso>/<city>/ hub page.
 *
 * Loaded automatically by WP's own template hierarchy once the rewrite rule
 * (added alongside the city/country taxonomy code) resolves a request as a
 * real `city` taxonomy archive. No Template Name header - this isn't a
 * page template, it's a taxonomy archive template.
 */

$city_term = get_queried_object();
if (!($city_term instanceof WP_Term) || $city_term->taxonomy !== 'city') {
    // Shouldn't happen given the rewrite rule only matches real city slugs,
    // but fail safe rather than render on a request this template can't
    // actually make sense of.
    wp_safe_redirect(home_url('/'), 302);
    exit;
}

$raw_country_slug  = get_query_var('hub_country', '');
$city_country_slug = function_exists('pickl_get_city_country_slug') ? pickl_get_city_country_slug($city_term) : '';

// The URL's country segment must actually match this city's own
// country_slug term-meta - the same check pickl_location_city_country_match()
// already does for venue permalinks. A real mismatch 301s to the correct
// URL; a city with no country_slug set at all (data not filled in yet)
// falls back to that country's locations page rather than rendering with
// an unknown country context.
if (empty($raw_country_slug) || empty($city_country_slug) || $raw_country_slug !== $city_country_slug) {
    if (!empty($city_country_slug)) {
        wp_safe_redirect(home_url('/' . $city_country_slug . '/' . $city_term->slug . '/'), 301);
    } else {
        $fallback_country = !empty($raw_country_slug) ? $raw_country_slug : 'ae';
        wp_safe_redirect(home_url('/' . $fallback_country . '/locations/'), 302);
    }
    exit;
}

// Venues actually in this city, re-validated the same way venue permalinks
// are: a post's city AND country terms must both be set and agree with
// each other, not just "tagged with this city term" - catches a venue
// mis-tagged into this city whose own country term doesn't actually match.
$venue_query = new WP_Query([
    'post_type'      => ['locations', 'location', 'pickl_location'],
    'posts_per_page' => -1,
    'post_status'    => 'publish',
    'tax_query'      => [
        [
            'taxonomy' => 'city',
            'field'    => 'term_id',
            'terms'    => $city_term->term_id,
        ],
    ],
]);

$venues = [];
if ($venue_query->have_posts()) {
    foreach ($venue_query->posts as $venue_post) {
        if (function_exists('pickl_location_city_country_match') && pickl_location_city_country_match($venue_post->ID)) {
            $venues[] = $venue_post;
        }
    }
}
wp_reset_postdata();

// Decided: a city with zero live venues isn't shown at all - redirect to
// that country's locations page rather than render a thin/empty page. Any
// future "browse by city" listing should apply this same live-venue check
// before linking to a city, so a dead link never gets created in the first
// place.
if (empty($venues)) {
    wp_safe_redirect(home_url('/' . $city_country_slug . '/locations/'), 302);
    exit;
}

get_header();

// Normalizes an ACF image field's value to a plain URL string - same
// helper single-location.php defines; guarded the same way so loading both
// templates in one request (unlikely, but cheap to guard) doesn't redeclare.
if (!function_exists('pickl_image_url')) {
    function pickl_image_url($value) {
        if (empty($value)) {
            return '';
        }
        if (is_string($value)) {
            return $value;
        }
        if (is_array($value)) {
            return $value['url'] ?? '';
        }
        if (is_object($value) && isset($value->url)) {
            return $value->url;
        }
        if (is_numeric($value)) {
            return wp_get_attachment_image_url((int) $value, 'large') ?: '';
        }
        return '';
    }
}

$country_term = get_term_by('slug', $city_country_slug, 'country');
$country_name = $country_term ? $country_term->name : strtoupper($city_country_slug);
$menu_link    = home_url('/' . $city_country_slug . '/menu/');

// Menu category highlights - same live pickl_menu_category lookup as
// single-location.php, driven by this city's country (every venue in it
// shares the same market) rather than a single venue's own terms. Function
// bodies are identical to single-location.php's, guarded the same way so
// loading both templates in one request doesn't redeclare either one.
$plugin_country_key = $country_term
    ? (get_term_meta($country_term->term_id, 'field_key_prefix', true) ?: $country_term->slug)
    : $city_country_slug;

if (!function_exists('pickl_category_has_items_for_country')) {
    function pickl_category_has_items_for_country($category_id, $country_key) {
        $item_ids = get_posts([
            'post_type'      => 'pickl_menu_item',
            'post_status'    => 'publish',
            'posts_per_page' => -1,
            'fields'         => 'ids',
            'meta_key'       => '_ssm_item_category',
            'meta_value'     => $category_id,
        ]);
        foreach ($item_ids as $item_id) {
            $disabled = get_post_meta($item_id, '_ssm_disabled_countries', true);
            if (!is_array($disabled)) {
                $disabled = [];
            }
            if (!in_array($country_key, $disabled, true)) {
                return true; // at least one item is live for this country
            }
        }
        return false;
    }
}
if (!function_exists('pickl_get_live_menu_categories')) {
    function pickl_get_live_menu_categories($country_key) {
        // Hidden from the menu-category highlights strip on request - still
        // live in the actual menu, just not shown as one of these cards.
        $pickl_hidden_categories = ['legendary melts', 'drinks', 'dessert', 'desserts', 'little pickl'];
        $posts = get_posts([
            'post_type'      => 'pickl_menu_category',
            'post_status'    => 'publish',
            'posts_per_page' => -1,
            'meta_key'       => '_ssm_category_order',
            'orderby'        => 'meta_value_num',
            'order'          => 'ASC',
        ]);
        $out = [];
        foreach ($posts as $p) {
            if (in_array(strtolower(trim($p->post_title)), $pickl_hidden_categories, true)) {
                continue;
            }
            if (!pickl_category_has_items_for_country($p->ID, $country_key)) {
                continue;
            }
            $image = pickl_image_url(get_field('category_image', $p->ID));
            if (!$image) {
                continue;
            }
            $out[] = [
                'id'    => $p->ID,
                'name'  => $p->post_title,
                'image' => $image,
            ];
        }
        return $out;
    }
}
$menu_categories = pickl_get_live_menu_categories($plugin_country_key);
// City hub copy (ACF field group "City - Hub content", on the city term).
// All optional: a city with nothing filled in renders exactly as before.
$city_intro_raw = function_exists('get_field') ? get_field('city_intro', $city_term) : '';
$city_intro     = $city_intro_raw ? wpautop($city_intro_raw) : '';
$city_sections  = function_exists('get_field') ? (get_field('city_sections', $city_term) ?: []) : [];
$city_faqs      = function_exists('get_field') ? (get_field('city_faqs', $city_term) ?: []) : [];
$city_h1        = function_exists('get_field') ? trim((string) get_field('city_h1', $city_term)) : '';
