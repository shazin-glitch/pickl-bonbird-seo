                        <?php endforeach; ?>
                        <?php if ($telephone || $maps_url) : ?>
                            <div class="pickl-contact-row">
                                <?php if ($telephone) : ?>
                                    <a href="tel:<?php echo esc_attr(preg_replace('/\s+/', '', $telephone)); ?>" class="pickl-phone-link">
                                        <svg class="pickl-icon" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                        <?php echo esc_html($telephone); ?>
                                    </a>
                                <?php else : ?><span></span><?php endif; ?>
                                <?php if ($maps_url) : ?>
                                    <a href="<?php echo esc_url($maps_url); ?>" target="_blank" rel="noopener" class="pickl-directions-link">Directions &rarr;</a>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>

        <?php if (!empty($city_sections)) : ?>
        <!-- CITY HUB COPY -->
        <div class="city-copy">
            <?php foreach ($city_sections as $section) :
                $heading = $section['heading'] ?? '';
                $body    = $section['body'] ?? '';
                if (!$heading && !$body) continue;
            ?>
                <div class="block">
                    <?php if ($heading) : ?><h2><?php echo esc_html($heading); ?></h2><?php endif; ?>
                    <?php if ($body) : ?><?php echo wp_kses_post(wpautop($body)); ?><?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
        <?php endif; ?>

        <?php if (!empty($menu_categories)) : ?>
        <!-- MENU CATEGORY HIGHLIGHTS -->
        <div class="menu-categories">
            <div class="list">
                <?php foreach ($menu_categories as $cat) : ?>
                    <a class="card" href="<?php echo esc_url($menu_link . '#ssm-category-' . $cat['id']); ?>">
                        <img src="<?php echo esc_url($cat['image']); ?>" alt="<?php echo esc_attr($cat['name']); ?>">
                        <span class="name"><?php echo esc_html($cat['name']); ?></span>
                    </a>
                <?php endforeach; ?>
            </div>
        </div>
        <?php endif; ?>

        <?php if (!empty($city_faqs)) : ?>
        <!-- CITY FAQs -->
        <div class="faqs city-faqs">
            <h2>FAQs</h2>
            <?php foreach ($city_faqs as $i => $row) :
                $question   = $row['question'] ?? '';
                $answer_raw = $row['answer'] ?? '';
                if (!$question && !$answer_raw) continue;
            ?>
                <details class="item"<?php if ($i === 0) : ?> open<?php endif; ?>>
                    <summary>
                        <span><?php echo esc_html($question); ?></span>
                        <span class="icon-toggle"></span>
                    </summary>
                    <?php if ($answer_raw) : ?>
                        <div class="answer"><?php echo wp_kses_post(wpautop($answer_raw)); ?></div>
                    <?php endif; ?>
                </details>
            <?php endforeach; ?>
        </div>
        <?php endif; ?>
    </div>
</section>
</main>

<?php get_footer(); ?>