$hero_bg          = pickl_image_url(get_field('hero_background_image')) ?: $featured_image; // hero_background_image field still needs creating in wp-admin

// Visit Blurb (section 2)
$blurb_a_heading    = get_field('blurb_a_heading');
$blurb_a_subheading = get_field('blurb_a_subheading');
$blurb_a_body_raw   = get_field('blurb_a_body');
