<?php
/**
 * Template Name: Dynamic Locations Directory
 * Description: Native ACF locations directory with default UAE handling & canonical fallback redirects.
 */

$raw_country_slug = get_query_var('country', '');

// Fetch all valid registered country taxonomy slugs
$valid_country_terms = get_terms([
    'taxonomy'   => 'country',
    'hide_empty' => false,
    'fields'     => 'slugs',
]);
if (is_wp_error($valid_country_terms)) {
    $valid_country_terms = [];
}

// Current request path vs. the canonical target path, used to guard
// against redirecting to a URL that's already the current one (self-loop).
$current_path = untrailingslashit(parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH));
$target_path  = untrailingslashit(parse_url(home_url('/locations/'), PHP_URL_PATH));

// 1. Redirect explicit /ae/ prefix to clean base URL (/locations/)
/*
if ($raw_country_slug === 'ae' && $current_path !== $target_path) {
    wp_safe_redirect(home_url('/locations/'), 301);
    exit;
}
*/
if (empty($raw_country_slug) && $current_path === $target_path) {
    wp_safe_redirect(home_url('/ae/locations/'), 301);
    exit;
}

// 2. Redirect invalid/unregistered country codes to default base URL
if (!empty($raw_country_slug) && !in_array($raw_country_slug, $valid_country_terms, true) && $current_path !== $target_path) {
    wp_safe_redirect(home_url('/locations/'), 302);
    exit;
}

// 3. Set internal active country: use the requested country if it actually
// has locations, otherwise fall back to UAE
$requested_country_slug = !empty($raw_country_slug) ? $raw_country_slug : 'ae';
$active_country_slug = function_exists('get_priority_location_country_slug')
    ? get_priority_location_country_slug($requested_country_slug)
    : $requested_country_slug;

get_header();

// Fetch all terms to render sections
$country_terms = get_terms([
    'taxonomy'   => 'country',
    'hide_empty' => true,
]);

// Float active country (UAE or current URL term) to the top of the layout
if (!empty($country_terms) && !is_wp_error($country_terms)) {
    usort($country_terms, function($a, $b) use ($active_country_slug) {
        if ($a->slug === $active_country_slug) return -1;
        if ($b->slug === $active_country_slug) return 1;
        return 0;
    });
}
