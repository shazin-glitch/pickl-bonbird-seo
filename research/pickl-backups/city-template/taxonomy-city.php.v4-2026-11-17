<script>
/* City map: MapLibre + OpenFreeMap (free, no key, no billing). Pink "P" pins
   from the Pickl logo, number bubbles where venues sit close together, venue
   cards floating along the bottom. Loads only when the map nears the screen. */
(function () {
    var wrap = document.querySelector('.pickl-city-hub .pk-mapwrap');
    var el = document.getElementById('pk-map');
    if (!wrap || !el) return;
    var strip = wrap.querySelector('.pk-strip');
    var cards = Array.prototype.slice.call(strip.querySelectorAll('.pk-card'));
    var arrows = wrap.querySelectorAll('.pk-arrow');
    var count = wrap.querySelector('.pk-count');
    var PIN = <?php echo wp_json_encode($pin_icon); ?>;
    var LIB = 'https://unpkg.com/maplibre-gl@4.7.1/dist/';
    var STYLE = 'https://tiles.openfreemap.org/styles/positron';
    var current = 0, lock = false, map = null;

    function cardPad() { return strip.offsetHeight + 40; }
    function show(i, opts) {
        opts = opts || {};
        i = Math.max(0, Math.min(cards.length - 1, i));
        current = i;
        cards.forEach(function (c, j) { c.classList.toggle('on', j === i); });
        if (count) count.textContent = (i + 1) + ' / ' + cards.length;
        if (arrows.length) { arrows[0].disabled = i === 0; arrows[1].disabled = i === cards.length - 1; }
        if (opts.scroll) {
            lock = true;
            strip.scrollTo({ left: cards[i].offsetLeft - 20, behavior: 'smooth' });
            setTimeout(function () { lock = false; }, 700);
        }
        var c = cards[i];
        if (map && c.dataset.lat) {
            map.flyTo({ center: [parseFloat(c.dataset.lng), parseFloat(c.dataset.lat)], zoom: 13, padding: { top: 40, bottom: cardPad(), left: 40, right: 40 }, speed: 1.4 });
        }
    }
    // Swipe (phone), trackpad swipe or scroll (desktop): when the strip settles,
    // the card at the front becomes the current one and the map flies to it.
    var t;
    strip.addEventListener('scroll', function () {
        if (lock) return;
        clearTimeout(t);
        t = setTimeout(function () {
            var best = 0, bd = 1e9;
            cards.forEach(function (c, j) { var d = Math.abs(c.offsetLeft - 20 - strip.scrollLeft); if (d < bd) { bd = d; best = j; } });
            if (strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4 && current > best) return;
            if (best !== current) show(best);
        }, 140);
    }, { passive: true });
    cards.forEach(function (c, j) {
        c.addEventListener('click', function (e) { if (e.target.closest('a')) return; show(j, { scroll: true }); });
    });
    Array.prototype.forEach.call(arrows, function (b) {
        b.addEventListener('click', function () { show(current + Number(b.dataset.d), { scroll: true }); });
    });

    function init() {
        var pts = [];
        var features = [];
        cards.forEach(function (c, j) {
            if (!c.dataset.lat) return;
            var p = [parseFloat(c.dataset.lng), parseFloat(c.dataset.lat)];
            pts.push(p);
            features.push({ type: 'Feature', properties: { i: j }, geometry: { type: 'Point', coordinates: p } });
        });
        map = new maplibregl.Map({ container: el, style: STYLE, attributionControl: false, cooperativeGestures: true, center: pts[0], zoom: 12 });
        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
        map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');
        map.on('load', function () {
            var att = el.querySelector('.maplibregl-ctrl-attrib');
            if (att) { att.classList.remove('maplibregl-compact-show'); att.removeAttribute('open'); }
            map.getStyle().layers.forEach(function (l) {
                if (/poi|aeroway|railway|highway-shield|road_shield|housenumber/.test(l.id)) map.setLayoutProperty(l.id, 'visibility', 'none');
            });
            var font = (map.getStyle().layers.filter(function (l) { return l.layout && l.layout['text-font']; })[0] || { layout: { 'text-font': ['Noto Sans Regular'] } }).layout['text-font'];
            var img = new Image();
            img.onload = function () {
                map.addImage('pickl-p', img, { pixelRatio: 3 });
                map.addSource('venues', { type: 'geojson', cluster: true, clusterRadius: 45, clusterMaxZoom: 13, data: { type: 'FeatureCollection', features: features } });
                map.addLayer({ id: 'pk-clusters', type: 'circle', source: 'venues', filter: ['has', 'point_count'], paint: { 'circle-color': '#E6007E', 'circle-radius': 20, 'circle-stroke-width': 3, 'circle-stroke-color': '#fff' } });
                map.addLayer({ id: 'pk-count', type: 'symbol', source: 'venues', filter: ['has', 'point_count'], layout: { 'text-field': ['get', 'point_count_abbreviated'], 'text-font': font, 'text-size': 16 }, paint: { 'text-color': '#fff' } });
                map.addLayer({ id: 'pk-pins', type: 'symbol', source: 'venues', filter: ['!', ['has', 'point_count']], layout: { 'icon-image': 'pickl-p', 'icon-anchor': 'bottom', 'icon-allow-overlap': true } });
                map.on('click', 'pk-pins', function (e) { show(e.features[0].properties.i, { scroll: true }); });
                map.on('click', 'pk-clusters', function (e) {
                    var f = e.features[0];
                    map.getSource('venues').getClusterExpansionZoom(f.properties.cluster_id).then(function (z) {
                        map.easeTo({ center: f.geometry.coordinates, zoom: z + 0.5, padding: { bottom: cardPad() } });
                    });
                });
                ['pk-clusters', 'pk-pins'].forEach(function (id) {
                    map.on('mouseenter', id, function () { map.getCanvas().style.cursor = 'pointer'; });
                    map.on('mouseleave', id, function () { map.getCanvas().style.cursor = ''; });
                });
            };
            img.src = PIN;

            // Start with every venue in view, then lock the map around them:
            // a little room to zoom out and pan, never off to the rest of the region.
            var pad = { top: 90, bottom: cardPad() + 20, left: 60, right: 60 };
            if (pts.length === 1) {
                map.jumpTo({ center: pts[0], zoom: 14, padding: pad });
            } else {
                var b = new maplibregl.LngLatBounds();
                pts.forEach(function (p) { b.extend(p); });
                map.fitBounds(b, { padding: pad, duration: 0, maxZoom: 14 });
            }
            var v = map.getBounds();
            var dx = (v.getEast() - v.getWest()) * 0.25, dy = (v.getNorth() - v.getSouth()) * 0.15;
            map.setMinZoom(map.getZoom() - 0.7);
            map.setMaxBounds([[v.getWest() - dx, v.getSouth() - dy], [v.getEast() + dx, v.getNorth() + dy]]);
        });
    }
    function load() {
        var css = document.createElement('link');
        css.rel = 'stylesheet'; css.href = LIB + 'maplibre-gl.css';
        document.head.appendChild(css);
        var s = document.createElement('script');
        s.src = LIB + 'maplibre-gl.js'; s.async = true; s.onload = init;
        document.head.appendChild(s);
    }
    if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); load(); }
        }, { rootMargin: '400px' });
        io.observe(wrap);
    } else { load(); }
})();
</script>
