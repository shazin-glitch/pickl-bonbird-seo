        <div class="ch-in">
            <div class="faqs">
                <h2>FAQs</h2>
                <?php foreach ($city_faqs as $i => $row) :
                    $question   = $row['question'] ?? '';
                    $answer_raw = $row['answer'] ?? '';
                    if (!$question && !$answer_raw) continue;
                ?>
                    <details class="item"<?php if ($i === 0) : ?> open<?php endif; ?>>
                        <summary><span><?php echo esc_html($question); ?></span><span class="icon-toggle"></span></summary>
                        <?php if ($answer_raw) : ?><div class="answer"><?php echo wp_kses_post(wpautop($answer_raw)); ?></div><?php endif; ?>
                    </details>
                <?php endforeach; ?>
            </div>
        </div>
