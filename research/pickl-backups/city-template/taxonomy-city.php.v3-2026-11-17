    <?php endif; ?>

</section>
</main>

<?php if ($show_map) : ?>
<script>
(function () {
    var el = document.getElementById('ch-map');
    if (!el) return;
    var pins = <?php echo wp_json_encode($map_pins); ?>;
    var key = <?php echo wp_json_encode($maps_key); ?>;
    // If the key is refused (referrer/billing), drop the map; the cards below still list every venue.
    window.gm_authFailure = function () { el.style.display = 'none'; };
    window.picklCityMapInit = function () {
        var g = google.maps;
        var map = new g.Map(el, {
            mapTypeControl: false, streetViewControl: false, fullscreenControl: false, clickableIcons: false,
            styles: [
                { featureType: 'poi', stylers: [{ visibility: 'off' }] },
                { featureType: 'transit', stylers: [{ visibility: 'off' }] },
                { elementType: 'geometry', stylers: [{ saturation: -100 }] },
                { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#cfe3e5' }] }
            ]
        });
        var icon = {
            url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="36" height="48" viewBox="0 0 36 48"><path d="M18 0C8 0 0 8 0 18c0 13 18 30 18 30s18-17 18-30C36 8 28 0 18 0z" fill="#E6007E"/><circle cx="18" cy="18" r="7" fill="#fff"/></svg>'),
            scaledSize: new g.Size(36, 48), anchor: new g.Point(18, 48)
        };
        var info = new g.InfoWindow();
        var bounds = new g.LatLngBounds();
        var esc = function (s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
        pins.forEach(function (p) {
            var pos = { lat: p.lat, lng: p.lng };
            var m = new g.Marker({ position: pos, map: map, icon: icon, title: p.name });
            bounds.extend(pos);
            m.addListener('click', function () {
                info.setContent('<div style="font:600 15px/1.4 sans-serif;padding:2px 4px"><a href="' + encodeURI(p.url) + '" style="color:#000">' + esc(p.name) + '</a>' +
                    (p.dir ? '<br><a href="' + encodeURI(p.dir) + '" target="_blank" rel="noopener" style="color:#E6007E;font-weight:600">Directions &rarr;</a>' : '') + '</div>');
                info.open(map, m);
            });
        });
        if (pins.length === 1) { map.setCenter(bounds.getCenter()); map.setZoom(15); }
        else { map.fitBounds(bounds, 50); }
    };
    function load() {
        var s = document.createElement('script');
        s.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) + '&callback=picklCityMapInit';
        s.async = true;
        document.head.appendChild(s);
    }
    // Only load Google Maps when the map is about to scroll into view (keeps the page fast).
    if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); load(); }
        }, { rootMargin: '300px' });
        io.observe(el);
    } else { load(); }
})();
</script>
<?php endif; ?>

