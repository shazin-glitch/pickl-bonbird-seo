                                    <a href="tel:<?php echo esc_attr(preg_replace('/\s+/', '', $telephone)); ?>" class="pickl-phone-link">
                                        <svg class="pickl-icon" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                        <?php echo esc_html($telephone); ?>
                                    </a>
                                <?php else : ?><span></span><?php endif; ?>
                                <?php if ($maps_url) : ?>
                                    <a href="<?php echo esc_url($maps_url); ?>" target="_blank" rel="noopener" class="pickl-directions-link">Directions &rarr;</a>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    </div>

    <?php
    $band_i = 0;
    $menu_done = false;
    foreach ($city_sections as $section) :
        $heading = trim((string) ($section['heading'] ?? ''));
        $body    = (string) ($section['body'] ?? '');
        $img_id  = (int) ($section['image'] ?? 0);
        $items   = !empty($section['items']) && is_array($section['items']) ? $section['items'] : [];
        if ($heading === '' && trim($body) === '' && !$items) continue;
        $band_i++;
        $cream = ($band_i % 2) === 1;
    ?>
    <div class="ch-band<?php echo $cream ? ' is-cream' : ''; ?>">
        <div class="ch-in">
            <?php if ($items) : ?>
                <?php if ($heading !== '') : ?><div class="ch-head"><h2><?php echo esc_html($heading); ?></h2></div><?php endif; ?>
                <div class="ch-items">
                    <?php foreach ($items as $item) :
                        $it_title = trim((string) ($item['title'] ?? ''));
                        $it_body  = (string) ($item['body'] ?? '');
                        $it_img   = (int) ($item['image'] ?? 0);
                    ?>
                        <div class="ch-item">
                            <?php if ($it_img) : ?><div class="ch-photo"><?php echo $ch_img($it_img, 'large', '', $it_title); ?></div><?php endif; ?>
                            <div class="ch-item-text">
                                <?php if ($it_title !== '') : ?><h3><?php echo esc_html($it_title); ?></h3><?php endif; ?>
                                <?php if (trim($it_body) !== '') echo wp_kses_post(wpautop($it_body)); ?>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
                <?php if (trim($body) !== '') : ?><div class="ch-after"><?php echo wp_kses_post(wpautop($body)); ?></div><?php endif; ?>
                <?php if (!$menu_done && !empty($menu_categories)) : $menu_done = true; ?>
                    <div class="menu-categories"><div class="list">
                        <?php foreach ($menu_categories as $cat) : ?>
                            <a class="card" href="<?php echo esc_url($menu_link . '#ssm-category-' . $cat['id']); ?>">
                                <img src="<?php echo esc_url($cat['image']); ?>" alt="<?php echo esc_attr($cat['name']); ?>" loading="lazy">
                                <span class="name"><?php echo esc_html($cat['name']); ?></span>
                            </a>
                        <?php endforeach; ?>
                    </div></div>
                <?php endif; ?>
            <?php elseif ($img_id) : ?>
                <div class="ch-split<?php echo ($band_i % 2) === 0 ? ' is-flip' : ''; ?>">
                    <div class="ch-photo"><?php echo $ch_img($img_id, 'large', ''); ?></div>
                    <div class="ch-text">
                        <?php if ($heading !== '') : ?><h2><?php echo esc_html($heading); ?></h2><?php endif; ?>
                        <?php echo wp_kses_post(wpautop($body)); ?>
                    </div>
                </div>
            <?php else : ?>
                <div class="ch-after">
                    <?php if ($heading !== '') : ?><h2><?php echo esc_html($heading); ?></h2><?php endif; ?>
                    <?php echo wp_kses_post(wpautop($body)); ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
    <?php endforeach; ?>

    <?php if (!$menu_done && !empty($menu_categories)) : $band_i++; ?>
    <div class="ch-band<?php echo ($band_i % 2) === 1 ? ' is-cream' : ''; ?>">
        <div class="ch-in">
            <div class="menu-categories" style="margin-top:0"><div class="list">
                <?php foreach ($menu_categories as $cat) : ?>
                    <a class="card" href="<?php echo esc_url($menu_link . '#ssm-category-' . $cat['id']); ?>">
                        <img src="<?php echo esc_url($cat['image']); ?>" alt="<?php echo esc_attr($cat['name']); ?>" loading="lazy">
                        <span class="name"><?php echo esc_html($cat['name']); ?></span>
